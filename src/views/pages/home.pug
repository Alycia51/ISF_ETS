extends ../layouts/base

block content

  section.hero
    .hero-bg
    .hero-overlay
    .hero-grid-pattern
    .container
      .hero__content
        h1.hero__title #{t.home.heroTitle}
        p.hero__subtitle #{t.home.heroSubtitle}
        .hero__actions
          a.btn.btn--primary(href=`/${locale}/contact`) #{t.home.heroBtn}
          a.btn.btn--outline(href=`/${locale}/mission`) #{t.home.aboutBtn}

  section.impact-stats
    .container
      .section-header
        h2 #{t.home.impactTitle}
        p #{t.home.impactSubtitle}
      .stats-grid
        each stat in t.home.impactStats
          .stat-item
            h3.stat-number #{stat.number}
            p.stat-label #{stat.label}

  section.about-preview
    .container.about__grid
      .about__image
        .globe-scene
          .globe-ring-a
          .globe-ring-b
          .globe-emoji 🌍
      .about__text
        h2 #{t.home.aboutTitle}
        p #{t.home.aboutText}
        a.link-more(href=`/${locale}/mission`) #{t.home.aboutBtn} →

    section.faq-section
    .container
      .section-header
        h2 #{t.home.faqTitle}
      .faq-list
        each item, i in t.home.faqItems
          .faq-item(data-index=i)
            button.faq-question(type='button')
              span #{item.q}
              span.faq-icon +
            .faq-answer
              p #{item.a}

  section.join-cta.join-cta--sky
    - var donateUrl = 'https://activitesphilanthropie.etsmtl.ca/CLUBSDONSCIEN/'
    .cta-sky(aria-hidden='true')
      - for (var i = 0; i < 90; i++)
        - var size = (Math.random() * 2 + 1).toFixed(1)
        span.star(style=`top:${(Math.random()*100).toFixed(1)}%;left:${(Math.random()*100).toFixed(1)}%;width:${size}px;height:${size}px;animation-delay:${(Math.random()*4).toFixed(2)}s;animation-duration:${(Math.random()*3+2).toFixed(2)}s`)
      span.shooting-star.shooting-star--1
      span.shooting-star.shooting-star--2
      span.shooting-star.shooting-star--3
    .container
      .cta-card
        h2 #{t.home.joinTitle}
        p #{t.home.joinText}
        .cta-actions
          a.btn.btn--white(href=`/${locale}/contact`) #{t.home.joinBtn}
          a.btn.btn--donate(href=donateUrl target='_blank' rel='noopener') #{t.home.donateBtn}