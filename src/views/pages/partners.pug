extends ../layouts/base

block content
  - var P = t.partners
  - var list = partnersList || []
  - var byTier = function (k) { return list.filter(function (p) { return p.tier === k; }); }
  - var dia = byTier('diamant'), orL = byTier('or'), arg = byTier('argent'), bro = byTier('bronze')
  - var countLbl = function (n) { return n + ' ' + (n > 1 ? P.partnerPlural : P.partnerSingular); }

  mixin tierHead(num, key)
    .tier-head
      span.big-num(aria-hidden='true') #{num}
      div
        p.tier-eyebrow(class=`tier-eyebrow--${key}`) #{P.tiers[key].eyebrow}
        h2.tier-title(id=`t-${key}`) #{P.tiers[key].title}

  mixin pcard(p, tier, suit, rank, tilt)
    - var tag = p.url ? 'a' : 'div'
    #{tag}.pcard(class=`pcard--${tier}` href=p.url || undefined target=p.url ? '_blank' : undefined rel=p.url ? 'noopener' : undefined data-tilt=tilt)
      .corner.c-tl
        span.suit #{suit}
        if rank
          span.rank #{rank}
      .corner.c-br
        span.suit #{suit}
        if rank
          span.rank #{rank}
      .pcard-body
        .pcard-logo
          if p.logo
            img(src=p.logo alt=p.name loading='lazy')
          else
            span #{p.initials}
        h3.pcard-name #{p.name}
        if p.url && tier === 'diamant'
          span.pcard-link #{P.visitSite}
      .foil.idle(class=`foil--${tier}`)

  .partners-page

    //- ── EN-TÊTE ──
    section.partners-hero
      .container.partners-hero__inner
        .partners-hero__text
          span.ph-badge
            span.ph-dot
            | #{P.badge} · #{countLbl(list.length)}
          h1.ph-title
            | #{P.heroTitle} 
            span #{P.heroAccent}
          p.ph-text #{P.heroText}
          .ph-actions
            a.btn.btn--dark(href=`/${locale}/contact`) #{P.joinBtn}
            a.btn.btn--line(href='#tier-diamant') #{P.packagesBtn}

        //- Éventail : chaque carte mène à sa section
        nav.hand(aria-label=P.handLabel)
          a.hpos.hp1(href='#tier-bronze')
            .hcard.hcard--bronze
              span.hcard-suit ▲
              div
                .hcard-title #{P.tiers.bronze.title}
                .hcard-count #{countLbl(bro.length)}
          a.hpos.hp2(href='#tier-argent')
            .hcard.hcard--argent
              span.hcard-suit ●
              div
                .hcard-title #{P.tiers.argent.title}
                .hcard-count #{countLbl(arg.length)}
          a.hpos.hp3(href='#tier-or')
            .hcard.hcard--or
              span.hcard-suit ★
              div
                .hcard-title #{P.tiers.or.title}
                .hcard-count #{orL.length ? countLbl(orL.length) : P.orHandLabel}
          a.hpos.hp4(href='#tier-diamant')
            .hcard.hcard--diamant
              span.hcard-suit ◆
              div
                .hcard-title #{P.tiers.diamant.title}
                .hcard-count #{countLbl(dia.length)}

    //- ── 01 DIAMANT ──
    section.tier-section#tier-diamant(aria-labelledby='t-diamant')
      .container
        +tierHead('01', 'diamant')
        .pgrid.pgrid--diamant
          each p, i in dia
            .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
              +pcard(p, 'diamant', '◆', 'D', 18)

    //- ── 02 OR ──
    section.tier-section#tier-or(aria-labelledby='t-or')
      .container
        +tierHead('02', 'or')
        if orL.length
          .pgrid.pgrid--argent
            each p, i in orL
              .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
                +pcard(p, 'or', '★', 'O', 16)
        else
          a.flip.or-slot(href=`/${locale}/contact` aria-label=`${P.orSlot.title} — ${P.orSlot.text}`)
            .flip-inner
              .face.face--front
                span.face-mark ★
                span.face-title #{P.orSlot.hiddenTitle}
                span.face-hint #{P.orSlot.hiddenHint}
              .face.face--back
                span.face-title.face-title--dark #{P.orSlot.title}
                span.face-text #{P.orSlot.text}
                span.face-btn #{P.orSlot.btn}

    //- ── 03 ARGENT ──
    section.tier-section#tier-argent(aria-labelledby='t-argent')
      .container
        +tierHead('03', 'argent')
        .pgrid.pgrid--argent
          each p, i in arg
            .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
              +pcard(p, 'argent', '●', 'A', 14)

    //- ── 04 BRONZE ──
    section.tier-section#tier-bronze(aria-labelledby='t-bronze')
      .container
        +tierHead('04', 'bronze')
        .pgrid.pgrid--bronze
          each p, i in bro
            .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
              +pcard(p, 'bronze', '▲', 'B', 12)

    //- ── VLOG / BLOG ──
    section.pvlog#vlog(aria-labelledby='t-vlog')
      .container
        p.pvlog-eyebrow #{P.vlog.eyebrow}
        h2.pvlog-title#t-vlog #{P.vlog.title}
        p.pvlog-text #{P.vlog.text}
        if P.posts.length
          .pvlog-grid
            each post in P.posts
              article.pvlog-card
                if post.image
                  .pvlog-media
                    img(src=post.image alt='' loading='lazy')
                    span.pvlog-format #{P.vlog.formats[post.format]}
                    if post.video
                      span.play
                        svg(width='24' height='24' viewBox='0 0 24 24' aria-hidden='true')
                          path(d='M8 5v14l11-7z' fill='#FFFFFF')
                else if post.logo
                  .pvlog-media.pvlog-media--logo
                    img(src=post.logo alt=post.partner loading='lazy')
                    span.pvlog-format #{P.vlog.formats[post.format]}
                else
                  .pvlog-media.pvlog-media--text
                    span.pvlog-quote-mark(aria-hidden='true') “
                    span.pvlog-format #{P.vlog.formats[post.format]}
                .pvlog-body
                  span.pvlog-partner #{post.partner}
                  h3 #{post.title}
                  if post.author
                    span.pvlog-author #{P.vlog.by} #{post.author}
                  p #{post.excerpt}
                  button.pvlog-more(type='button') #{P.vlog.readMore}

                //- Contenu complet, affiché dans la fenêtre
                .post-full(hidden)
                  if post.image
                    img.post-full-img(src=post.image alt='')
                  else if post.logo
                    img.post-full-logo(src=post.logo alt=post.partner)
                  span.pvlog-partner #{post.partner}
                  h3.post-full-title #{post.title}
                  if post.author
                    p.post-full-author #{P.vlog.by} #{post.author}
                  if post.lang && post.lang !== locale && P.vlog.langNote
                    p.post-full-lang #{P.vlog.langNote}
                  if post.quote
                    blockquote.post-full-quote #{post.quote}
                  if post.intro
                    p.post-full-text #{post.intro}
                  each sec in post.sections || []
                    h4.post-full-heading #{sec.heading}
                    p.post-full-text #{sec.body}
                  if post.url
                    a.btn.btn--primary.post-full-link(href=post.url target='_blank' rel='noopener') #{P.vlog.readOn} ↗
                  if post.video
                    a.btn.btn--primary(href=post.video target='_blank' rel='noopener') ▶ #{P.vlog.watch}
        else
          p.pvlog-empty #{P.vlog.empty}

    .post-backdrop#postBackdrop
    .post-modal#postModal(role='dialog' aria-modal='true')
      button.post-close#postClose(type='button' aria-label='Fermer') ✕
      .post-modal-body#postModalBody

    //- ── DEVENIR PARTENAIRE ──
    section.partners-cta(aria-labelledby='t-cta')
      .container
        .partners-cta__box
          .partners-cta__suits(aria-hidden='true')
            span ◆
            span ★
            span ●
            span ▲
          h2#t-cta #{P.cta.title}
          p #{P.cta.text}
          a.btn.btn--primary(href=`/${locale}/contact`) #{P.cta.btn}