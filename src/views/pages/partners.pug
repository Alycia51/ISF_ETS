extends ../layouts/base

block content
  - var P = t.partners
  - var list = partnersList || []
  - var byTier = function (k) { return list.filter(function (p) { return p.tier === k; }); }
  - var dia = byTier('diamant'), orL = byTier('or'), arg = byTier('argent'), bro = byTier('bronze'), spe = byTier('special')
  - var countLbl = function (n) { return n + ' ' + (n > 1 ? P.partnerPlural : P.partnerSingular); }

  mixin tierHead(num, key)
    .tier-head
      span.big-num(aria-hidden='true') #{num}
      div
        p.tier-eyebrow(class=`tier-eyebrow--${key}`) #{P.tiers[key].eyebrow}
        h2.tier-title(id=`t-${key}`) #{P.tiers[key].title}

  mixin pcard(p, tier, suit, rank, tilt)
    - var tag = p.url ? 'a' : 'div'
    #{tag}.pcard(class=`pcard--${tier}` href=p.url || undefined target=p.url ? '_blank' : undefined rel=p.url ? 'noopener' : undefined data-tilt=tilt)
      .corner.c-tl
        span.suit #{suit}
        if rank
          span.rank #{rank}
      .corner.c-br
        span.suit #{suit}
        if rank
          span.rank #{rank}
      .pcard-body
        .pcard-logo
          if p.logo
            img(src=p.logo alt=p.name loading='lazy')
          else
            span #{p.initials}
        h3.pcard-name #{p.name}
        if p.url && tier === 'diamant'
          span.pcard-link #{P.visitSite}
      .foil.idle(class=`foil--${tier}`)

  .partners-page

    //- ── EN-TÊTE ──
    section.partners-hero
      .container.partners-hero__inner
        .partners-hero__text
          span.ph-badge
            span.ph-dot
            | #{P.badge} · #{countLbl(list.length)}
          h1.ph-title
            | #{P.heroTitle} 
            span #{P.heroAccent}
          p.ph-text #{P.heroText}
          .ph-actions
            a.btn.btn--dark(href=`/${locale}/contact`) #{P.joinBtn}
            a.btn.btn--line(href='#forfaits') #{P.packagesBtn}

        .hand(role='img' aria-label=P.handLabel)
          .hpos.hp1
            .hcard.hcard--bronze
              span.hcard-suit ▲
              div
                .hcard-title #{P.tiers.bronze.title}
                .hcard-count #{countLbl(bro.length)}
          .hpos.hp2
            .hcard.hcard--argent
              span.hcard-suit ●
              div
                .hcard-title #{P.tiers.argent.title}
                .hcard-count #{countLbl(arg.length)}
          .hpos.hp3
            .hcard.hcard--special
              span.hcard-suit ★
              div
                .hcard-title #{P.tiers.special.title}
                .hcard-count #{countLbl(spe.length)}
          .hpos.hp4
            .hcard.hcard--or
              span.hcard-suit ?
              div
                .hcard-title #{P.tiers.or.title}
                .hcard-count #{orL.length ? countLbl(orL.length) : P.orHandLabel}
          .hpos.hp5
            .hcard.hcard--diamant
              span.hcard-suit ◆
              div
                .hcard-title #{P.tiers.diamant.title}
                .hcard-count #{countLbl(dia.length)}

    //- ── 01 DIAMANT ──
    section.tier-section(aria-labelledby='t-diamant')
      .container
        +tierHead('01', 'diamant')
        .pgrid.pgrid--diamant
          each p, i in dia
            .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
              +pcard(p, 'diamant', '◆', 'D', 18)

    //- ── 02 OR ──
    section.tier-section(aria-labelledby='t-or')
      .container
        +tierHead('02', 'or')
        if orL.length
          .pgrid.pgrid--argent
            each p, i in orL
              .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
                +pcard(p, 'or', '?', 'O', 16)
        else
          a.flip.or-slot(href=`/${locale}/contact` aria-label=`${P.orSlot.title} — ${P.orSlot.text}`)
            .flip-inner
              .face.face--front
                span.face-mark ?
                span.face-title #{P.orSlot.hiddenTitle}
                span.face-hint #{P.orSlot.hiddenHint}
              .face.face--back
                span.face-title.face-title--dark #{P.orSlot.title}
                span.face-text #{P.orSlot.text}
                span.face-btn #{P.orSlot.btn}

    //- ── 03 ARGENT ──
    section.tier-section(aria-labelledby='t-argent')
      .container
        +tierHead('03', 'argent')
        .pgrid.pgrid--argent
          each p, i in arg
            .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
              +pcard(p, 'argent', '●', 'A', 14)

    //- ── 04 BRONZE ──
    section.tier-section(aria-labelledby='t-bronze')
      .container
        +tierHead('04', 'bronze')
        .pgrid.pgrid--bronze
          each p, i in bro
            .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
              +pcard(p, 'bronze', '▲', 'B', 12)

    //- ── 05 SPÉCIAL ──
    if spe.length
      section.tier-section(aria-labelledby='t-special')
        .container
          +tierHead('05', 'special')
          .pgrid.pgrid--special
            each p, i in spe
              .deal(style=`animation-delay:${(i * 0.09).toFixed(2)}s`)
                +pcard(p, 'special', '★', '', 14)

    //- ── VLOG / BLOG ──
    section.pvlog#vlog(aria-labelledby='t-vlog')
      .container
        p.pvlog-eyebrow #{P.vlog.eyebrow}
        h2.pvlog-title#t-vlog #{P.vlog.title}
        p.pvlog-text #{P.vlog.text}
        if P.posts.length
          .pvlog-grid
            each post in P.posts
              article.pvlog-card
                .pvlog-media
                  if post.image
                    img(src=post.image alt='' loading='lazy')
                  span.pvlog-format #{post.format}
                  if post.video
                    span.play
                      svg(width='24' height='24' viewBox='0 0 24 24' aria-hidden='true')
                        path(d='M8 5v14l11-7z' fill='#FFFFFF')
                .pvlog-body
                  span.pvlog-partner #{post.partner}
                  h3 #{post.title}
                  p #{post.excerpt}
                  button.pvlog-more(type='button') #{P.vlog.readMore}
                .post-full(hidden)
                  if post.image
                    img.post-full-img(src=post.image alt='')
                  span.pvlog-partner #{post.partner}
                  h3.post-full-title #{post.title}
                  p.post-full-text #{post.text}
                  if post.video
                    a.btn.btn--primary(href=post.video target='_blank' rel='noopener') ▶ #{P.vlog.watch}
        else
          p.pvlog-empty #{P.vlog.empty}

    .post-backdrop#postBackdrop
    .post-modal#postModal(role='dialog' aria-modal='true')
      button.post-close#postClose(type='button' aria-label='Fermer') ✕
      .post-modal-body#postModalBody

    //- ── FORFAITS ──
    section.packages#forfaits(aria-labelledby='t-packages')
      .container
        .packages-box
          .packages-head
            div
              h2#t-packages #{P.packages.title}
              p #{P.packages.text}
            button.perks-toggle#perksToggle(type='button' aria-expanded='false' aria-controls='perksTable' data-show=P.packages.show data-hide=P.packages.hide) #{P.packages.show}

          .packages-grid
            each tier, i in P.packages.tiers
              .package
                .package-head(class=`package-head--${i}`)
                  .package-name #{tier.name}
                  .package-price #{tier.price}
                ul.package-perks
                  each perk in tier.perks
                    li #{perk}

          .perks-table#perksTable
            .perks-scroll
              table
                thead
                  tr
                    th(scope='col') #{P.packages.header}
                    each tier, i in P.packages.tiers
                      th(scope='col' class=`th--${i}`)
                        | #{tier.name}
                        small #{tier.price}
                each sec in P.packages.table
                  tbody
                    tr.perks-sec
                      th(colspan='5' scope='colgroup') #{sec.title}
                    each row in sec.rows
                      tr
                        th(scope='row') #{row.label}
                        each v, i in row.values
                          td
                            if v === '●'
                              span.perk-dot(class=`perk-dot--${i}` aria-hidden='true')
                              span.sr-only #{P.packages.included}
                            else if v === '—'
                              span.perk-none(aria-hidden='true') —
                              span.sr-only #{P.packages.notIncluded}
                            else
                              | #{v}