extends ../../layouts/base

block content
  - var aboutLabel = locale === 'en' ? 'About' : locale === 'es' ? 'Acerca de' : 'À propos'
  - var cat = t.projects.categories.tournoi

  header.page-header
    .container
      h1 #{cat.title}
      p #{cat.subtitle}

  section.project-detail
    .container
      .project-detail-layout

        //- Gauche : description
        .project-desc
          h2.detail-section-title #{aboutLabel}
          p.typed-text(data-text=cat.description)

        //- Droite : tuile Automne 2026
        .project-photos
          .vintage-cards-row
            .vintage-card(data-edition='tournoi-2026' role='button' tabindex='0' aria-label=cat.edition style='cursor:pointer')
              .vintage-card-inner
                .vintage-photo-area
                  img(src='/images/realisations/tournoi/cover.jpg' alt=cat.edition loading='lazy' onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'")
                  .coming-soon-card(style='display:none')
                    span.coming-soon-camera 📷
                    .coming-soon-text
                      span #{cat.comingSoon}
                      span.dots
                        span .
                        span .
                        span .
                .vintage-card-footer
                  span #{cat.edition}
              .vintage-card-shine

  //- Album : 4 sections dans l'ordre Volleyball, Basketball, Badminton, Futsal
  .album-backdrop(id='backdrop-tournoi-2026')
  .album-modal(id='modal-tournoi-2026')
    button.album-close(type='button' aria-label='Fermer') ✕
    each sport, si in cat.sports
      .album-section
        h3.album-section-title #{sport.name}
        if sport.photos.length
          .album-grid
            each photo, i in sport.photos
              .album-thumb(data-src=photo data-section=`tournoi-${si}` data-index=i)
                img(src=photo alt=sport.name loading='lazy')
        else
          .album-coming
            span #{cat.comingSoon}
            span.dots
              span .
              span .
              span .

  //- Lightbox
  .lightbox(id='lightbox')
    button.lightbox-close(id='lightboxClose') ✕
    button.lightbox-prev(id='lightboxPrev') ‹
    button.lightbox-next(id='lightboxNext') ›
    .lightbox-content(id='lightboxContent')