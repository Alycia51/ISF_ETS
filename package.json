{
    "name": "isf-ets",
    "version": "1.0.0",
    "description": "Site web du club ISF de l'ÉTS - Ingénieurs Sans Frontières",
    "main": "dist/server.js",
    "scripts": {
        "build": "npm run build:css && tsc",
        "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/public/css/tailwind.css --minify",
        "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/public/css/tailwind.css --watch",
        "start": "node dist/server.js",
        "dev": "nodemon --watch src -e ts,pug,json --exec ts-node src/server.ts"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^4.22.1",
        "nodemailer": "^6.6.3",
        "pug": "^3.0.4"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.5",
        "@types/express": "^4.17.25",
        "@types/node": "^20.19.37",
        "@types/nodemailer": "^6.4.14",
        "@types/pug": "^2.0.10",
        "nodemon": "^3.1.14",
        "tailwindcss": "^4.3.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Alycia51/ISF_ETS.git"
    },
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Alycia51/ISF_ETS/issues"
    },
    "homepage": "https://github.com/Alycia51/ISF_ETS#readme"
}
