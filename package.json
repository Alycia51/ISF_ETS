{
    "name": "isf-ets",
    "version": "1.0.0",
    "description": "Site web du club ISF de l'ÉTS - Ingénieurs Sans Frontières",
    "main": "dist/server.js",
    "scripts": {
        "build:css": "tailwindcss -i src/styles/input.css -o src/public/css/main.css --minify",
        "build:ts": "tsc",
        "build": "npm run build:css && npm run build:ts",
        "dev:css": "tailwindcss -i src/styles/input.css -o src/public/css/main.css --watch",
        "dev:server": "ts-node src/server.ts",
        "dev": "concurrently -n \"css,server\" -c \"cyan,magenta\" \"npm run dev:css\" \"npm run dev:server\"",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^4.22.1",
        "nodemailer": "^6.6.3",
        "pug": "^3.0.4"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.4",
        "@types/express": "^4.17.25",
        "@types/node": "^20.19.37",
        "@types/nodemailer": "^6.4.14",
        "@types/pug": "^2.0.10",
        "concurrently": "^10.0.6",
        "nodemon": "^3.1.14",
        "tailwindcss": "^4.3.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Alycia51/ISF_ETS.git"
    },
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Alycia51/ISF_ETS/issues"
    },
    "homepage": "https://github.com/Alycia51/ISF_ETS#readme"
}
